# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EXISTING FIREBASE PROJECT CONFIGURATION (Client SDK)
# Connect your existing Firebase project without creating a new one:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# FIRST ADMIN / OWNER CONFIGURATION
VITE_ADMIN_OWNER_EMAIL="ahmed0soliman6@gmail.com"
VITE_ADMIN_OWNER_UID=""
ADMIN_OWNER_EMAIL="ahmed0soliman6@gmail.com"
ADMIN_OWNER_UID=""

# FIREBASE ADMIN SDK & CENTRALIZED SESSION SECURITY (Server-Only Secrets)
# Never expose these variables with VITE_ prefix.
# FIREBASE_SERVICE_ACCOUNT_JSON: Full JSON string (or Base64-encoded JSON) of Firebase Service Account
FIREBASE_SERVICE_ACCOUNT_JSON=""
# ADMIN_SESSION_SECRET: Minimum 32-byte random cryptographic secret for HMAC-SHA256 admin session signing
ADMIN_SESSION_SECRET=""

# PERSISTENT PUBLIC SNAPSHOT STORAGE (Server-Only Vercel Blob Token)
# Required in production so all Vercel Serverless instances share the published public snapshot with 0 public Firestore reads.
BLOB_READ_WRITE_TOKEN=""

# CLOUDINARY CONFIGURATION (Server-Side Signed Upload & Media Optimization)
# Never expose CLOUDINARY_API_SECRET in the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="ahmed-soliman-platform"
